# ============================================
# .htaccess limpio para graficos
# Frontend + Backend (PHP + JS)
# ============================================

# Evita listar archivos
Options -Indexes
Options +FollowSymLinks

# Activa el motor de reescritura
RewriteEngine On

# ============================================
# CACHÉ INTELIGENTE PARA PRODUCCIÓN
# ============================================
<IfModule mod_headers.c>
    # HTML: Sin caché (siempre verifica)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    
    # JS y CSS: Caché corto con validación
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # JSON: Sin caché
    <FilesMatch "\.(json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    
    # Imágenes: Caché largo
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Fuentes: Caché muy largo
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================
# BACKEND
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^backend/?(.*)$ backend/index.php [L,QSA]

# Backend accedido con prefijo /frontend/ (URLs ya emitidas con ese prefijo)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^frontend/backend/?(.*)$ backend/index.php [L,QSA]

# ============================================
# FRONTEND
# ============================================
RewriteCond %{REQUEST_URI} !/frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*\.(js|html|css))$ frontend/$1 [L,QSA]

RewriteCond %{REQUEST_URI} !/frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(js|css|img|assets|fonts|views)/(.*)$ frontend/$1/$2 [L,QSA]

RewriteCond %{REQUEST_URI} !/frontend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^frontend/?(.*)$ frontend/$1 [END,QSA]

DirectoryIndex frontend/index.html
RewriteRule ^$ frontend/index.html [L]
