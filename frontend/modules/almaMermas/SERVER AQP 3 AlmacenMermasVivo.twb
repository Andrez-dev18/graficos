          <datasource-dependencies datasource='federated.1cwsp0o1ba42dr1e3ga3f1k0k174'>
            <column caption='SUM([mermatotal])/sum([entrada])' datatype='real' name='[Calculation_1040894517382963200]' role='measure' type='quantitative' user:unnamed='Hoja 1'>
              <calculation class='tableau' formula='SUM([mermatotal])/sum([entrada])' />
            </column>
            <column caption='((SUM([mermatotal])/sum([entrada]))-avg([objetivo]))/avg([obj...' datatype='real' name='[Calculation_1199083429086105601]' role='measure' type='quantitative' user:unnamed='PorcMermaProcesoDiaClienteZonaPlaca'>
              <calculation class='tableau' formula='((SUM([mermatotal])/sum([entrada]))-avg([objetivo]))/avg([objetivo])' />
            </column>
