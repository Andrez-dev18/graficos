    <worksheet name='AnalisisMermasEscalable'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Mermas Mes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='almacen' name='federated.1bn969z1ac0ez51e9ic3y04db5nu' />
          </datasources>
          <datasource-dependencies datasource='federated.1bn969z1ac0ez51e9ic3y04db5nu'>
            <column caption='Cant' datatype='real' name='[Calculation_1794121513093951488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tcantid] ELSE -1*[tcantid] END' />
            </column>
            <column caption='%MermaPeso' datatype='real' name='[Calculation_516788081169129474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MermaS823 (copia)])/([MermaS800 (copia 2)] + [E100Entrada (copia)])' />
            </column>
            <column caption='Peso' datatype='real' name='[Cant (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tpeso] ELSE -1*[tpeso] END' />
            </column>
            <column caption='E101Entrada' datatype='real' name='[E100Entrada (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [tcodtra]=&quot;E101&quot; THEN [tpeso] ELSE 0 END)' />
            </column>
            <column caption='E100Entrada' datatype='real' name='[MermaS800 (copia 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [tcodtra]=&quot;E100&quot; THEN [tpeso] ELSE 0 END)' />
            </column>
            <column caption='S8XXMerma' datatype='real' name='[MermaS823 (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF &#13;&#10;[tcodtra]=&quot;S800&quot; OR &#13;&#10;[tcodtra]=&quot;S801&quot; OR &#13;&#10;[tcodtra]=&quot;S803&quot; OR &#13;&#10;[tcodtra]=&quot;S804&quot; OR &#13;&#10;[tcodtra]=&quot;S809&quot; OR &#13;&#10;[tcodtra]=&quot;S810&quot; OR &#13;&#10;[tcodtra]=&quot;S823&quot; &#13;&#10;THEN [tpeso] ELSE 0 END)' />
            </column>
            <column caption='Valor' datatype='real' name='[Peso (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tkardex] ELSE -1*[tkardex] END' />
            </column>
            <column-instance column='[talm]' derivation='None' name='[none:talm:nk]' pivot='key' type='nominal' />
