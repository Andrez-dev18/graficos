            <column caption='E100Entrada' datatype='real' name='[MermaS800 (copia 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [tcodtra]=&quot;E100&quot; THEN [tpeso] ELSE 0 END)' />
