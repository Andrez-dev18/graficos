      <aliases enabled='yes' />
      <column caption='Cant' datatype='real' name='[Calculation_1794121513093951488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tcantid] ELSE -1*[tcantid] END' />
      </column>
      <column caption='PP' datatype='real' name='[Calculation_1794121513096028161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Cant (copia)])/sum([Calculation_1794121513093951488])' />
      </column>
      <column caption='S800Transporte' datatype='real' name='[Calculation_516788081166102529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [tcodtra]=&quot;S800&quot; THEN [tpeso] ELSE 0 END)' />
      </column>
      <column caption='%MermaPeso' datatype='real' name='[Calculation_516788081169129474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MermaS823 (copia)])/([MermaS800 (copia 2)] + [E100Entrada (copia)])' />
      </column>
      <column caption='Indice' datatype='string' datatype-customized='true' name='[Calculation_763641637212028928]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INDEX())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Detalle' datatype='string' datatype-customized='true' name='[Calculation_763641637234225153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([tprocli]) + &quot; &quot; + STR([tplaca]) + &quot; &quot; + STR([tcodigo]) + &quot; &quot; + STR([tfecfac])' />
      </column>
      <column caption='Fech' datatype='string' datatype-customized='true' name='[Calculation_763641637482242050]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ATTR([tfecfac]))' />
      </column>
      <column caption='Peso' datatype='real' name='[Cant (copia)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tpeso] ELSE -1*[tpeso] END' />
