              <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tcantid] ELSE -1*[tcantid] END' />
            </column>
            <column caption='%MermaPeso' datatype='real' name='[Calculation_516788081169129474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MermaS823 (copia)])/([MermaS800 (copia 2)] + [E100Entrada (copia)])' />
            </column>
            <column caption='Peso' datatype='real' name='[Cant (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LEFT([tcodtra],1) = &quot;E&quot; THEN [tpeso] ELSE -1*[tpeso] END' />
            </column>
            <column caption='E101Entrada' datatype='real' name='[E100Entrada (copia)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [tcodtra]=&quot;E101&quot; THEN [tpeso] ELSE 0 END)' />
